match /hubFinance/{id} {
 allow get, list: if hubAdmin() && hubReady();
 allow create: if hubAdmin() && hubReady()
 && request.resource.data.keys().hasAll(['date','kind','category','fund','description','amount','updatedBy','updatedAt'])
 && request.resource.data.keys().hasOnly(['date','kind','category','fund','description','amount','updatedBy','updatedAt'])
 && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
 && request.resource.data.kind in ['Income','Expenditure','Opening credit','Opening debit']
 && request.resource.data.category in ['Membership','Fundraising','Sponsorship','Donation','Grant','Pitch hire','Insurance','Equipment','Travel','Office','Other','Opening balance']
 && request.resource.data.fund is string && request.resource.data.fund.size() > 0 && request.resource.data.fund.size() <= 80
 && request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 200
 && request.resource.data.amount is int && request.resource.data.amount > 0 && request.resource.data.amount <= 100000000
 && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
 allow update, delete: if false;
}
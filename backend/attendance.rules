// Insert inside match /databases/{database}/documents, alongside existing Hub matches.
// Requires existing hubAdmin() and hubReady() helpers.
match /hubAttendancePlayers/{id} {
  allow get, list: if hubAdmin() && hubReady();
  allow create, update: if hubAdmin() && hubReady()
    && request.resource.data.keys().hasAll(['name','group','active','updatedBy','updatedAt'])
    && request.resource.data.keys().hasOnly(['name','group','active','updatedBy','updatedAt'])
    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
    && request.resource.data.group in ['Eagles','Hawks','Cubs']
    && request.resource.data.active is bool
    && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
  allow delete: if false;
}
match /hubAttendanceSessions/{id} {
  allow get, list: if hubAdmin() && hubReady();
  allow create, update: if hubAdmin() && hubReady()
    && request.resource.data.keys().hasAll(['date','group','kind','marks','updatedBy','updatedAt'])
    && request.resource.data.keys().hasOnly(['date','group','kind','marks','updatedBy','updatedAt'])
    && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && request.resource.data.group in ['Eagles','Hawks','Cubs']
    && request.resource.data.kind in ['Training','Match']
    && id == request.resource.data.date + '_' + request.resource.data.group + '_' + request.resource.data.kind
    && request.resource.data.marks is map && request.resource.data.marks.size() <= 200
    && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
  allow delete: if false;
}
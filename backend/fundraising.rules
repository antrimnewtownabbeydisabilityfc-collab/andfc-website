match /hubFundraising/{id} {
 allow get,list: if hubAdmin() && hubReady();
 allow create: if hubAdmin() && hubReady() && request.resource.data.keys().hasAll(['kind','name','date','week','score','income','expense','expected','status','note','updatedBy','updatedAt']) && request.resource.data.keys().hasOnly(['kind','name','date','week','score','income','expense','expected','status','note','updatedBy','updatedAt']) && request.resource.data.kind in ['Top Bins','Football card','Bucket collection','Donation','Night at the Races','Other'] && hubText(request.resource.data.name,100) && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.week is int && request.resource.data.week >= 0 && request.resource.data.week <= 4 && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 10000 && request.resource.data.income is int && request.resource.data.income >= 0 && request.resource.data.income <= 100000000 && request.resource.data.expense is int && request.resource.data.expense >= 0 && request.resource.data.expense <= 100000000 && request.resource.data.expected is int && request.resource.data.expected >= 0 && request.resource.data.expected <= 100000000 && request.resource.data.status in ['Pending','Confirmed','Completed','Declined'] && request.resource.data.note is string && request.resource.data.note.size() <= 500 && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
 allow update,delete: if false;
}